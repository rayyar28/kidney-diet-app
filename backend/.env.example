DATABASE_URL="postgresql://kidney_app:kidney_app_password@db:5432/kidney_diet?schema=public"

# JWT — 千萬不要照抄這兩個值！每個環境都要換成自己的隨機字串，
# 可以用「node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"」產生。
# 這兩個值只要外流，任何人都能偽造出任何病人的登入憑證。
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# 本機檔案儲存路徑 (容器內路徑，透過 volume 對應到 host)
UPLOAD_DIR="/app/uploads"

PORT=4000
CORS_ORIGIN="http://localhost:5173"
