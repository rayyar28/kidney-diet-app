# ---------------------------------------------------------------------------
# 本機開發用。複製成 .env 後填入實際值。
# 正式環境的值請在 Render 的 Dashboard 設定，不要放在檔案裡。
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://kidney_app:kidney_app_password@db:5432/kidney_diet?schema=public"

# JWT — 千萬不要照抄這兩個值！每個環境都要換成自己的隨機字串，
# 可以用「node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"」產生。
# 這兩個值只要外流，任何人都能偽造出任何病人的登入憑證。
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
# 登入狀態可以維持多久沒有連上伺服器。格式：30d / 12h / 15m / 3600s。
# 這個值同時決定 JWT 與資料庫紀錄的到期時間，兩者一定一致。
#
# 怎麼挑：病人「最長多久會連上伺服器一次」決定了這個值。
#   - 洗腎病人（一週來院三次）：30d 很夠
#   - 一般門診病人（2~3 個月回診一次）：要設成 180d 以上，
#     否則病人帶著累積的紀錄回診時會發現被登出、得重新登入才能上傳
# 設越長，憑證萬一外洩的有效期也越長，要依實際收案情境取捨。
JWT_REFRESH_EXPIRES_IN="30d"

PORT=4000

# 允許的前端來源。可用逗號分隔多組：
#   CORS_ORIGIN="https://kidney-diet.pages.dev,http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"

# ---------------------------------------------------------------------------
# 照片儲存
#   STORAGE_DRIVER=local  → 存到本機 UPLOAD_DIR（開發用）
#   STORAGE_DRIVER=r2     → 存到 Cloudflare R2（正式用）
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
UPLOAD_DIR="/app/uploads"

# STORAGE_DRIVER=r2 時才需要下面這些
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# 照片簽名網址的有效秒數
SIGNED_URL_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# 忘記密碼
# ---------------------------------------------------------------------------
# 重設代碼的有效時間。格式同上：60m / 2h / 3600s。
PASSWORD_RESET_EXPIRES_IN="60m"

# 前端網址，用來組出信件裡的重設連結。沒設定的話信裡就只有代碼（App 使用者是打代碼的，
# 不影響功能）。例如 APP_URL="https://kidney-diet.pages.dev"
APP_URL=""

# 寄信方式：
#   MAIL_DRIVER=console → 只把信件內容印在後端 log，不需要任何帳號（開發用）
#   MAIL_DRIVER=resend  → 透過 Resend 的 HTTP API 真的寄出去（正式用）
MAIL_DRIVER="console"

# MAIL_DRIVER=resend 時才需要。
# ⚠ MAIL_FROM 的網域必須先在 Resend 驗證過，否則信會進垃圾信或被退回。
RESEND_API_KEY=""
MAIL_FROM=""
