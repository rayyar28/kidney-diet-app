# ---------------------------------------------------------------------------
# 本機開發用。複製成 .env 後填入實際值。
# 正式環境的值請在 Render 的 Dashboard 設定，不要放在檔案裡。
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://kidney_app:kidney_app_password@db:5432/kidney_diet?schema=public"

# JWT — 千萬不要照抄這兩個值！每個環境都要換成自己的隨機字串，
# 可以用「node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"」產生。
# 這兩個值只要外流，任何人都能偽造出任何病人的登入憑證。
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

PORT=4000

# 允許的前端來源。可用逗號分隔多組：
#   CORS_ORIGIN="https://kidney-diet.pages.dev,http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"

# ---------------------------------------------------------------------------
# 照片儲存
#   STORAGE_DRIVER=local  → 存到本機 UPLOAD_DIR（開發用）
#   STORAGE_DRIVER=r2     → 存到 Cloudflare R2（正式用）
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
UPLOAD_DIR="/app/uploads"

# STORAGE_DRIVER=r2 時才需要下面這些
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# 照片簽名網址的有效秒數
SIGNED_URL_TTL_SECONDS=300
