# 複製成 .env 後填值。.env 已經在 .gitignore 裡，不會進版控。
# 兩組密鑰各跑一次這個指令產生（在有裝 Node 的機器上，或 docker run --rm node:20 node -e "..."）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ★ 用 hex 不用 base64：base64 會出現 @ # / : 等字元，放進某些設定檔或連線字串時
#   會被誤解析，而錯誤訊息通常跟真正的原因差很遠，很難查。
#
# 資料庫不需要密碼——它是 SQLite，就是 data/ 底下的一個檔案。

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# 登入狀態可以維持多久沒有連上伺服器。預設一年，通常不用動（不設就是 365d）。
# 這不是安全參數而是可用性參數：病人只有在院內 Wi-Fi 才連得到這台機器，
# 設太短的話他回診時會發現自己被登出，而他的帳號是衛教師建的、他多半不知道密碼。
JWT_REFRESH_EXPIRES_IN=365d

# 這台機器對外的名稱。病人的 APK 會把 https://<這個名稱>/api 寫死在裡面。
SERVER_NAME=kidney.hosp.local
CORS_ORIGIN=https://kidney.hosp.local
