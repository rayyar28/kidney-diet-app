node_modules
dist

# 打包出來的 APK 是建置產物，不進版控：每次重建都是一個新的 4MB 二進位檔，
# 會讓 repo 無止境長大，而且從原始碼隨時可以重新產生。
# 要發給別人時，用 GitHub Releases 或直接傳檔案。
*.apk

# 環境變數：只有 *.example 可以進版控
.env
.env.*
!.env.example
!.env.production.example

*.local

# SQLite 資料庫本體（含 WAL 的兩個附檔）。這是病人的資料，絕對不能進版控。
backend/data/
*.db
*.db-journal
*.db-wal
*.db-shm

backend/uploads/*
!backend/uploads/.gitkeep
.devdata/
*.tsbuildinfo

# 醫院主機的實際設定（IP、port、CA 路徑）。repo 是公開的，這些會指出是哪一家醫院，不能進版控。
deploy/hospital.local.json
# 打包醫院版 APK 時暫時放進去的 CA（scripts/hospital-apk.mjs apply 產生、restore 刪掉）
frontend/android/app/src/main/res/raw/hospital_ca.pem
# 給醫院主機的離線安裝包（scripts/build-hospital-bundle.mjs 產生）
release/
